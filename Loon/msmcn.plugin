#!name = MSMCN 汉化
#!desc = 自动核对最新 Release，并替换同资源版本的 iOS 汉化文件
#!author = MapleRen
#!homepage = https://github.com/MapleRen/MapleStoryM-language
#!system = iOS,iPadOS
#!type = normal

[Argument]
enabled = switch,true,tag=启用汉化,desc=关闭后所有资源请求均使用官方原始地址

[Script]
http-request ^http:\/\/maplemkorea\.dn\.nexoncdn\.co\.kr\/(?:GooglePlay|AppStore)\/[^/]+\/[^/]+\/(?:AOS|IOS)_[^/]+_(?:AssetBundle_table\.bin|(?:7111698|7143146|7243978|7299980|7350716|7360955|7605927|7881518)\.msm)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MapleRen/MapleStoryM-language/v4/Script/msmcn.js,tag=MSMCN 汉化,timeout=20,argument=[{enabled}],enable=true
